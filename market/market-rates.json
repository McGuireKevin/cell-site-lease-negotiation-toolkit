    {
      "category": "ANTENNAS",
      "item": "Panel antenna - standard (<50 lb)",
      "baseline": 90.0,
      "tierScaled": true,
      "note": "The workhorse adder. Weight-banded schedules are standard practice; this is the light band."
    },
    {
      "category": "ANTENNAS",
      "item": "Panel antenna - heavy (50-110 lb)",
      "baseline": 130.0,
      "tierScaled": true,
      "note": "Covers massive-MIMO and multi-band panels. Roughly 1.4x the light band, matching the weight-class spreads seen in towerco schedules."
    },
    {
      "category": "RADIOS AND ANCILLARY",
      "item": "Remote radio unit (RRU / RRH)",
      "baseline": 100.0,
      "tierScaled": true,
      "note": "The item that actually matters on a modern site: 40-60 lb each, mounted high, and multiplying with every band added."
    },
    {
      "category": "RADIOS AND ANCILLARY",
      "item": "Tower-mounted amplifier (TMA)",
      "baseline": 40.0,
      "tierScaled": true,
      "note": "Largely obsolete - function absorbed into RRUs. Confirm the hardware is live before billing it."
    },
    {
      "category": "RADIOS AND ANCILLARY",
      "item": "Diplexer / combiner",
      "baseline": 40.0,
      "tierScaled": true,
      "note": "Priced the same as an amplifier in real towerco schedules because both sit in the 35 lb weight class."
    },
    {
      "category": "RADIOS AND ANCILLARY",
      "item": "RET (remote electrical tilt)",
      "baseline": 15.0,
      "tierScaled": true,
      "note": "Now usually integrated into the antenna assembly. Frequently should not be billed as a separate unit at all."
    },
    {
      "category": "RADIOS AND ANCILLARY",
      "item": "GPS antenna",
      "baseline": 30.0,
      "tierScaled": true,
      "note": "Negligible weight and wind load. Many current schedules bundle it rather than charging separately."
    },
    {
      "category": "CABLE AND TRANSMISSION",
      "item": "Coax line 1-5/8\"",
      "baseline": 30.0,
      "tierScaled": true,
      "note": "Legacy architecture. On a 5G site most coax runs have been replaced by hybrid trunk - audit for abandoned runs before counting."
    },
    {
      "category": "CABLE AND TRANSMISSION",
      "item": "Coax line 2-1/4\"",
      "baseline": 40.0,
      "tierScaled": true,
      "note": "Same caution. Larger diameter, more wind load, modest premium."
    },
    {
      "category": "CABLE AND TRANSMISSION",
      "item": "Hybrid fiber / DC trunk",
      "baseline": 55.0,
      "tierScaled": true,
      "note": "One trunk displaces 12-18 coax runs. Price it above a single coax but well below the runs it replaced, or the schedule double-counts."
    },
    {
      "category": "MICROWAVE - BAND BY DIAMETER",
      "item": "MW dish - 2 ft",
      "baseline": 225.0,
      "tierScaled": true,
      "note": "Doubling dish diameter increases weight and wind load by roughly 4x, so a single microwave line item is always wrong."
    },
    {
      "category": "MICROWAVE - BAND BY DIAMETER",
      "item": "MW dish - 4 ft",
      "baseline": 450.0,
      "tierScaled": true,
      "note": "Anchored on an executed lease exhibit at $460/mo."
    },
    {
      "category": "MICROWAVE - BAND BY DIAMETER",
      "item": "MW dish - 6 ft",
      "baseline": 800.0,
      "tierScaled": true,
      "note": "Exhibit anchor $900/mo; the roughly $100-per-vertical-foot-per-month rule of thumb implies about $600. Band is set between them."
    },
    {
      "category": "MICROWAVE - BAND BY DIAMETER",
      "item": "MW dish - 8 ft+",
      "baseline": 1200.0,
      "tierScaled": true,
      "note": "Rare on macro sites and almost always a structural conversation before a rent conversation."
